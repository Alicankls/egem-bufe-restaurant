# Veritabanı (Neon PostgreSQL) — https://neon.tech üzerinden ücretsiz oluşturulabilir
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Auth.js
AUTH_SECRET="npx auth secret ile üretin veya rastgele 32+ karakter bir string"
NEXTAUTH_URL="http://localhost:3000"

# İlk admin kullanıcı (yalnızca seed script'i tarafından okunur)
ADMIN_EMAIL="admin@egemtrak.com"
ADMIN_PASSWORD="güçlü-bir-şifre-belirleyin"

# Vercel Blob (görsel yükleme) — Vercel projesinin Storage sekmesinden alınır
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# --- İletişim formu e-posta gönderimi ---
# Form mesajlarının gönderileceği adres:
CONTACT_TO_EMAIL="ozkanegemseeit@gmail.com"

# Aşağıdaki İKİ yöntemden BİRİNİ doldurmanız yeterlidir (ikisi de boşsa form
# "gönderilemedi" hatası verir ve mesaj hiçbir yere iletilmez).

# 1) Resend (önerilen) — https://resend.com üzerinden ücretsiz API anahtarı alın;
#    ek servis/paket yapılandırması gerekmez.
RESEND_API_KEY=""

# 2) Gmail/SMTP — Gmail hesabında 2 adımlı doğrulamayı açıp "uygulama şifresi"
#    üretin (16 karakter). Değerleri doldurunca gönderim Gmail üzerinden yapılır.
#    İlk satırı kendi Gmail adresinizle değiştirin.
SMTP_USER=""
SMTP_PASS=""
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"

# Gönderen adresi (opsiyonel). Boş bırakılırsa: SMTP için SMTP_USER adresi,
# Resend için "EGEM Web Sitesi <onboarding@resend.dev>" kullanılır.
CONTACT_FROM_EMAIL=""
